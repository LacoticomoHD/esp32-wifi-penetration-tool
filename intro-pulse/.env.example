# INTRO Pulse — Umgebungsvariablen. Kopiere diese Datei nach .env und trage
# deine Werte ein. .env ist per .gitignore ausgeschlossen und landet nie im Repo.

# --- Phase 2: KI-Analyse (Claude) ---------------------------------------------
# API-Key aus der Anthropic Console (console.anthropic.com → API Keys).
# Getrennt vom Claude-Pro-Abo. Bleibt serverseitig, nie im Browser.
ANTHROPIC_API_KEY=sk-ant-...

# --- Phase 1, Schritt 4–5: Persistenz (Supabase) ------------------------------
# Projekt-URL und PUBLIC anon/publishable Key. Der anon-Key ist öffentlich
# (darf in den Browser) — geschützt werden die Daten über Row Level Security.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...

# Nur serverseitig, falls Admin-Automationen nötig werden (z. B. Nutzer anlegen).
# NIEMALS in den Browser geben — umgeht RLS komplett.
# SUPABASE_SERVICE_ROLE_KEY=...
